#!/usr/bin/env bash
#
# Negative-test harness for check-tenant-isolation.sh (invoked via its
# --self-test flag). Proves the plain gate actually FAILS on a direct
# callsite and that the reviewed exemptions (tests, the db package, the
# tenant resolver, the global-table reader) never count as offenders — so
# the gate can never silently decay into a vacuous pass (the failure mode
# the sibling architecture checker's self-test also guards against).
#
# Strategy: build a throwaway fixture tree and point the real checker at
# it via TENANT_CHECK_ROOT, then assert the exit codes for clean / dirty
# states.

set -euo pipefail

SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/check-tenant-isolation.sh"

if ! command -v rg >/dev/null 2>&1; then
  echo "self-test: ripgrep (rg) required but not on PATH." >&2
  exit 2
fi

FIX="$(mktemp -d)"
trap 'rm -rf "$FIX"' EXIT

mkdir -p "$FIX/artifacts/resupply-api/src/routes" \
  "$FIX/artifacts/resupply-api/src/middlewares" \
  "$FIX/artifacts/resupply-api/src/lib/billing" \
  "$FIX/lib/resupply-db/src"

# Exempt callers — each calls the raw client but must NEVER be flagged:
#   * a test file (tests construct clients directly)
#   * the db package (owns the client + the wrapper)
#   * requireAdmin (the tenant resolver, runs before org context exists)
#   * identity-resolver (reads the global dme_organization singleton)
printf 'const c = getSupabaseServiceRoleClient();\n' \
  >"$FIX/artifacts/resupply-api/src/routes/alpha.test.ts"
printf 'export const x = getSupabaseServiceRoleClient();\n' \
  >"$FIX/lib/resupply-db/src/supabase-client.ts"
printf 'const c = getSupabaseServiceRoleClient();\n' \
  >"$FIX/artifacts/resupply-api/src/middlewares/requireAdmin.ts"
printf 'const c = getSupabaseServiceRoleClient();\n' \
  >"$FIX/artifacts/resupply-api/src/lib/billing/identity-resolver.ts"

run() {
  TENANT_CHECK_ROOT="$FIX" bash "$SCRIPT" "$@"
}

pass=0
fail=0
check() { # check <desc> <expected-exit> <actual-exit>
  if [[ "$2" == "$3" ]]; then
    echo "  ok: $1"
    pass=$((pass + 1))
  else
    echo "  FAIL: $1 (expected exit $2, got $3)" >&2
    fail=$((fail + 1))
  fi
}

set +e

# 1. Clean tree: only exempt callers present → pass.
run >/dev/null 2>&1
check "clean tree (only exempt callers) passes" 0 $?

# 2. A real offender (an ordinary route) → hard fail.
printf 'const c = getSupabaseServiceRoleClient();\n' \
  >"$FIX/artifacts/resupply-api/src/routes/beta.ts"
run >/dev/null 2>&1
check "direct callsite in a route fails" 1 $?

# 3. The failure output must name the offender (not an exempt file).
out="$(run 2>&1)"
if grep -q "routes/beta.ts" <<<"$out"; then
  echo "  ok: violation output names the offending file"
  pass=$((pass + 1))
else
  echo "  FAIL: violation output did not name the offender" >&2
  fail=$((fail + 1))
fi

# 4. Cut the offender over to the chokepoint → back to a clean pass.
printf 'const c = getOrgScopedClient(orgId);\n' \
  >"$FIX/artifacts/resupply-api/src/routes/beta.ts"
run >/dev/null 2>&1
check "offender cut over to getOrgScopedClient passes" 0 $?

# 5. A bare import (no call) must NOT count as an offender.
printf 'import { getSupabaseServiceRoleClient } from "@workspace/resupply-db";\n' \
  >"$FIX/artifacts/resupply-api/src/routes/gamma.ts"
run >/dev/null 2>&1
check "bare import (no call) does not fail" 0 $?

set -e

echo "check-tenant-isolation self-test: ${pass} passed, ${fail} failed."
[[ "$fail" -eq 0 ]]
